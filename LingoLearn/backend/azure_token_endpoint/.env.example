PORT=3000
# Azure region of your Speech resource, e.g. eastus, westeurope
AZURE_SPEECH_REGION=eastus
# Short name of your Azure Speech resource (used to build the app endpoint),
# e.g. the "myspeech" in "myspeech.cognitiveservices.azure.com"
AZURE_SPEECH_RESOURCE=your-speech-resource
# Azure Speech key (server-side only; never ship this in the Flutter app)
AZURE_SPEECH_KEY=replace-with-your-key
# Optional: override the exact base URL the app should call.
# AZURE_SPEECH_ENDPOINT=